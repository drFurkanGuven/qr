# ==============================================================================
# Yetkili Üniversite Yoklama Sistemi - Ortam Değişkenleri (.env.example)
# ==============================================================================

PROJECT_NAME="Yetkili Üniversite Yoklama Sistemi"
ENVIRONMENT=production
DEBUG=False
APP_PORT=8001

# Şifreleme ve Kriptografik Anahtar (En az 64 karakterli rastgele anahtar)
SECRET_KEY=BURAYA_EN_AZ_64_KARAKTERLI_GUCLU_RASTGELE_ANAHTAR_URETIN

# PostgreSQL Veritabanı
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=qr_admin
POSTGRES_PASSWORD=GuvenliPostgresSifresi123!
POSTGRES_DB=qr_university
DATABASE_URL=postgresql+asyncpg://qr_admin:GuvenliPostgresSifresi123!@db:5432/qr_university

# Fırat Üniversitesi Bilinen Servis URL'leri
CAS_SERVER_URL=https://jasig.firat.edu.tr/cas
CAS_SERVICE_URL=https://qr.firat.edu.tr
FIRAT_API_BASE_URL=https://qr.firat.edu.tr/api
FIRAT_CAS_TOKEN_ENDPOINT=https://qr.firat.edu.tr/api/auth/cas/token
FIRAT_ATTENDANCE_VERIFY_ENDPOINT=https://qr.firat.edu.tr/api/attendance/verify
FIRAT_ATTENDANCE_SHOW_ENDPOINT=https://qr.firat.edu.tr/api/attendance/show
FIRAT_DEVICE_REGISTER_ENDPOINT=https://qr.firat.edu.tr/api/device/register
FIRAT_USER_ENDPOINT=https://qr.firat.edu.tr/api/user

# Upstream Entegrasyon Modu (True: Resmi Fırat API'sine istek atar, False: Otonom mod)
UPSTREAM_MODE=False

# Güvenli Oturum Çerezi (httpOnly Cookie)
COOKIE_NAME=session_token
COOKIE_SECURE=True
COOKIE_SAMESITE=lax
COOKIE_MAX_AGE_SECONDS=86400
COOKIE_DOMAIN=.firat.edu.tr

# QR Rotasyon & Geçerlilik Süreleri (saniye)
QR_ROTATION_SECONDS=30
QR_TOLERANCE_SECONDS=15

# Audit Log Tuzlama Anahtarı
AUDIT_SALT=firat-qr-audit-salt-2026

# CORS Origins (JSON dizisi)
BACKEND_CORS_ORIGINS=["https://qr.firat.edu.tr","https://yoklama.firat.edu.tr","http://localhost:3000","http://127.0.0.1:3000"]
