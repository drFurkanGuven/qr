{
  "expo": {
    "name": "Fırat Yoklama",
    "slug": "firat-yoklama",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "tr.edu.firat.yoklama",
      "infoPlist": {
        "NSCameraUsageDescription": "Ders tahtasındaki yoklama QR kodunu taramak için kamera erişimi gereklidir."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "tr.edu.firat.yoklama",
      "permissions": [
        "CAMERA",
        "INTERNET"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Ders tahtasındaki yoklama QR kodunu taramak için kamera erişimi gereklidir."
        }
      ]
    ]
  }
}
